# Copy this file to `.env` (next to manage.py) and fill in what you need.
# Every value is optional for local development.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
COLLEGE_NAME=KJSIT

# --- Database ---
# sqlite (default) or mysql
DB_ENGINE=sqlite
DB_NAME=community
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Sign-in ---
ALLOWED_EMAIL_DOMAINS=somaiya.edu
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail (console output when EMAIL_HOST_USER is empty) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Google Calendar (service account shared on the calendar with "Make changes to events") ---
GOOGLE_SERVICE_ACCOUNT_FILE=community-450615-ea7ca3c3bfa3.json
GOOGLE_CALENDAR_ID=

# --- AI report generation ---
# auto | anthropic | huggingface | template
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
